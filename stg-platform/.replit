modules = ["nodejs-20", "python-3.11"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.development]
VITE_REQUIRE_AUTH = "false"
VITE_API_BASE_URL = "http://localhost:8000"

[userenv.shared]

[userenv.production]
VITE_REQUIRE_AUTH = "false"
VITE_API_BASE_URL = "https://stgcore-40--lizmaciel159.replit.app"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "STG Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "STG API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "STG Bot"

[[workflows.workflow]]
name = "STG Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "STG API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd ../backend && python -m uvicorn core.main:app --host 0.0.0.0 --port 8000 --reload"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "STG Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd .. && if [ -d bot ]; then python bot/main.py; else echo 'Bot Discord nao encontrado; pulando.'; fi"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd frontend && npm install && npm run build"]
publicDir = "frontend/dist"
run = ["sh", "-c", "cd frontend && node server.js"]
