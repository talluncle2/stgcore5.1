# STG Core API Environment Variables
# Copy this to .env and fill in the values

# Database - PostgreSQL (Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/stg_db

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
DISCORD_TOKEN=your_discord_bot_token

# Guild Configuration
GUILD_ID=your_guild_id
ADMIN_ROLE_IDS=role_id1,role_id2
MODERATOR_ROLE_IDS=role_id3,role_id4
DASHBOARD_ALLOWED_ROLE_IDS=role_id5,role_id6

# API Security
BOT_API_KEY=your_secure_bot_api_key
INTERNAL_SYNC_KEY=your_internal_job_key
CONTENT_CREATOR_ROLE_IDS=123456789,987654321
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
JWT_SECRET_KEY=your_secure_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Environment
DEBUG=true
ENVIRONMENT=development
